# Copy this file to .env and add your own private credentials.
GEMINI_API_KEY=your_gemini_api_key
QDRANT_URL=https://YOUR-CLUSTER-URL
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=company_knowledge_gemini

# You can change this model name if your Gemini API account uses another available model.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash